+void
+XHCI::_DetectControllerQuirks()
+{
+	fQuirks = 0;
+
+	TRACE_ALWAYS("detecting controller quirks for vendor 0x%04x device 0x%04x\n",
+		fPCIInfo->vendor_id, fPCIInfo->device_id);
+
+	switch (fPCIInfo->vendor_id) {
+		case PCI_VENDOR_INTEL:
+			// Intel controllers need IMOD quirk to avoid IRQ lockups
+			switch (fPCIInfo->device_id) {
+				case PCI_DEVICE_INTEL_PANTHER_POINT_XHCI:
+				case PCI_DEVICE_INTEL_LYNX_POINT_XHCI:
+				case PCI_DEVICE_INTEL_LYNX_POINT_LP_XHCI:
+				case PCI_DEVICE_INTEL_BAYTRAIL_XHCI:
+				case PCI_DEVICE_INTEL_WILDCAT_POINT_XHCI:
+				case PCI_DEVICE_INTEL_WILDCAT_POINT_LP_XHCI:
+					fQuirks |= XHCI_QUIRK_INTEL_IMOD | XHCI_QUIRK_INTEL_PPWR;
+					TRACE_ALWAYS("Intel early xHCI: IMOD and port power quirks enabled\n");
+					break;
+				default:
+					// Newer Intel may still need some quirks
+					fQuirks |= XHCI_QUIRK_INTEL_IMOD;
+					break;
+			}
+			break;
+
+		case PCI_VENDOR_AMD:
+			// AMD controllers may need PLL workaround
+			fQuirks |= XHCI_QUIRK_AMD_PLL;
+			TRACE_ALWAYS("AMD xHCI: PLL quirk enabled\n");
+			break;
+
+		case PCI_VENDOR_ASMEDIA:
+			// ASMedia controllers need extra delays for stability
+			fQuirks |= XHCI_QUIRK_ASMEDIA_DELAY | XHCI_QUIRK_EXTRA_DELAY;
+			TRACE_ALWAYS("ASMedia xHCI: delay quirks enabled\n");
+			break;
+
+		case PCI_VENDOR_VIA:
+			// VIA VL805 (Raspberry Pi 4) has some quirks
+			if (fPCIInfo->device_id == PCI_DEVICE_VIA_VL805) {
+				fQuirks |= XHCI_QUIRK_RESET_ON_RESUME;
+				TRACE_ALWAYS("VIA VL805: reset-on-resume quirk enabled\n");
+			}
+			break;
+
+		case PCI_VENDOR_FRESCO:
+			// Fresco Logic controllers often have MSI issues
+			fQuirks |= XHCI_QUIRK_TRUST_TX_LEN;
+			TRACE_ALWAYS("Fresco Logic xHCI: trust TX length quirk enabled\n");
+			break;
+
+		case PCI_VENDOR_RENESAS:
+			// Renesas/NEC controllers are generally well-behaved
+			TRACE_ALWAYS("Renesas xHCI: no quirks needed\n");
+			break;
+
+		case PCI_VENDOR_ETRON:
+			// Etron controllers may need extra delays
+			fQuirks |= XHCI_QUIRK_EXTRA_DELAY;
+			TRACE_ALWAYS("Etron xHCI: extra delay quirk enabled\n");
+			break;
+
+		default:
+			TRACE_ALWAYS("unknown xHCI vendor, no quirks applied\n");
+			break;
+	}
+}
