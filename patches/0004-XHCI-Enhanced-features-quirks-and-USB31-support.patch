+void
+XHCI::_ParseProtocolSpeedIds(uint32 eecp)
+{
+	// Parse Protocol Speed ID (PSIV) entries from Extended Capability
+	// This is used for USB 3.1+ to determine exact speed variants
+	// (XHCI 1.1 § 7.2.2)
+
+	uint32 psic = XHCI_SUPPORTED_PROTOCOLS_2_PSIC(ReadCapReg32(eecp + 8));
+
+	if (psic == 0) {
+		// No Protocol Speed IDs defined, use default mappings
+		return;
+	}
+
+	TRACE("parsing %u protocol speed IDs at eecp 0x%x\n", (unsigned)psic, (unsigned)eecp);
+
+	// PSI entries start at offset 16 (dword 4) in the extended capability
+	for (uint32 i = 0; i < psic && i < 16; i++) {
+		uint32 psi = ReadCapReg32(eecp + 16 + (i * 4));
+		uint8 psiv = XHCI_PSI_VALUE(psi);
+		uint8 exponent = XHCI_PSI_EXPONENT(psi);
+		uint16 mantissa = XHCI_PSI_MANTISSA(psi);
+
+		// Calculate speed in Mbps for logging
+		uint32 speedMbps = mantissa;
+		switch (exponent) {
+			case 0: speedMbps /= 1000; break;	// bps -> Mbps (essentially 0)
+			case 1: speedMbps /= 1000; break;	// Kbps -> Mbps
+			case 2: break;						// Mbps
+			case 3: speedMbps *= 1000; break;	// Gbps -> Mbps
+		}
+
+		TRACE("  PSIV %u: %u %s (%u Mbps)\n", psiv, mantissa,
+			exponent == 0 ? "bps" : exponent == 1 ? "Kbps" :
+			exponent == 2 ? "Mbps" : "Gbps", speedMbps);
+
+		// Store info for ports using this protocol
+		uint32 temp = ReadCapReg32(eecp + 8);
+		uint32 offset = XHCI_SUPPORTED_PROTOCOLS_1_OFFSET(temp);
+		uint32 count = XHCI_SUPPORTED_PROTOCOLS_1_COUNT(temp);
+
+		if (offset > 0 && offset <= XHCI_MAX_PORTS) {
+			for (uint32 p = offset - 1; p < offset - 1 + count && p < XHCI_MAX_PORTS; p++) {
+				// Only store if PSIV matches what the port reports
+				// This will be checked when determining port speed
+				if (fPortSpeedInfo[p].psiv == 0 || fPortSpeedInfo[p].psiv == psiv) {
+					fPortSpeedInfo[p].psiv = psiv;
+					fPortSpeedInfo[p].exponent = exponent;
+					fPortSpeedInfo[p].mantissa = mantissa;
+				}
+			}
+		}
+	}
+}
