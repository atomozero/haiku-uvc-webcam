+status_t
+XHCI::_RecoverFromError(xhci_endpoint* endpoint, uint32 completionCode)
+{
+	// Enhanced error recovery based on completion code
+	// This implements retry logic similar to FreeBSD/Linux
+
+	status_t status = B_OK;
+
+	switch (completionCode) {
+		case COMP_USB_TRANSACTION:
+			// USB transaction error - usually transient, try reset
+			TRACE_ERROR("USB transaction error, attempting endpoint reset\n");
+			status = ResetEndpoint(false, endpoint);
+			if (status == B_OK) {
+				fConsecutiveResetErrors = 0;
+			} else {
+				fConsecutiveResetErrors++;
+			}
+			break;
+
+		case COMP_STALL:
+			// Stall - endpoint halted, needs reset
+			TRACE_ERROR("endpoint stalled, resetting\n");
+			status = ResetEndpoint(false, endpoint);
+			break;
+
+		case COMP_BABBLE:
+			// Babble - device sent more data than expected
+			TRACE_ERROR("babble detected, resetting endpoint\n");
+			status = ResetEndpoint(false, endpoint);
+			break;
+
+		case COMP_TRB:
+			// TRB error - usually a software bug
+			TRACE_ERROR("TRB error, possible driver bug\n");
+			status = B_DEV_INVALID_IOCTL;
+			break;
+
+		case COMP_RING_UNDERRUN:
+		case COMP_RING_OVERRUN:
+			// Isochronous errors - not really recoverable, but not fatal
+			TRACE("isochronous ring %s\n",
+				completionCode == COMP_RING_UNDERRUN ? "underrun" : "overrun");
+			status = B_OK;
+			break;
+
+		case COMP_BANDWIDTH:
+		case COMP_BANDWIDTH_OVERRUN:
+			// Bandwidth issues - need to reduce transfer rate
+			TRACE_ERROR("bandwidth error, may need to reduce data rate\n");
+			status = B_DEV_RESOURCE_CONFLICT;
+			break;
+
+		case COMP_NO_SLOTS:
+			// No available device slots
+			TRACE_ERROR("no device slots available\n");
+			status = B_NO_MORE_FDS;
+			break;
+
+		case COMP_CONTEXT_STATE:
+			// Context state error - endpoint in wrong state
+			TRACE_ERROR("context state error, endpoint in unexpected state\n");
+			// Try to recover by stopping and restarting
+			StopEndpoint(false, endpoint);
+			status = B_DEV_NOT_READY;
+			break;
+
+		default:
+			// Unknown or unrecoverable error
+			if (completionCode >= COMP_UNDEFINED) {
+				TRACE_ERROR("undefined completion code %u\n", (unsigned)completionCode);
+			}
+			status = B_IO_ERROR;
+			break;
+	}
+
+	// If we've had too many consecutive reset errors, something is very wrong
+	if (fConsecutiveResetErrors > 5) {
+		TRACE_ERROR("too many consecutive reset errors, device may be broken\n");
+		fConsecutiveResetErrors = 0;
+		return B_DEV_BAD_DRIVE_NUM;
+	}
+
+	return status;
+}
